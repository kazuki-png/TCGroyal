{
  "expo": {
    "name": "TCG ROYAL Preview",
    "slug": "tcg-royal-lending",
    "version": "1.12.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "カードや本人確認書類の撮影にカメラを使用します。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "カード画像や本人確認書類の写真を選択するため写真へアクセスします。",
          "cameraPermission": "カードや本人確認書類の撮影にカメラを使用します。",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "lending-test",
          "color": "#fcd66e"
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "com.tcgroyal.lending.preview",
      "buildNumber": "21",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tcgroyal.lending.preview",
      "versionCode": 21,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tcgroyal-preview"
  }
}
